# 1. Credenciais Hostinger SMTP (Obrigatório para enviar e-mails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@thebosspro.com
SMTP_PASS=COLOQUE_SUA_SENHA_AQUI

# 2. Segurança Hotmart (hottok do webhook)
HOTMART_TOKEN=COLOQUE_SEU_HOTTOK_AQUI

# 3. Porta do Servidor (Evite mudar)
PORT=3001
